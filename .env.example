# Copy to .env and replace EVERY placeholder. Generate secrets with:  openssl rand -base64 48
# Use only letters, digits and - _ . in DB/Redis passwords (they pass through sqlcmd/JDBC/redis-cli).

# --- SQL Server ---
MSSQL_SA_PASSWORD=change-me-Str0ng-SA-passw0rd
DB_PASSWORD=change-me-Str0ng-app-passw0rd

# --- Redis ---
REDIS_PASSWORD=change-me-redis-passw0rd

# --- Security secrets (shared between backend and gateway) ---
JWT_SECRET=change-me-at-least-32-bytes-of-random-data-0000
API_KEY_PEPPER=change-me-at-least-32-chars-of-random-data-111
GATEWAY_TOKEN=change-me-gateway-to-management-shared-token

# --- First administrator (created only if no admin exists) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-passw0rd

# --- Upstream destination policy ---
ALLOWED_UPSTREAM_HOSTS=catalog-service,order-service
ALLOW_PRIVATE_UPSTREAMS=true
ALLOW_LOOPBACK_UPSTREAMS=false
TRUSTED_PROXIES=172.16.0.0/12

# --- Optional tuning ---
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D
CONFIG_REFRESH_MS=5000
MAX_CONFIG_STALE_SECONDS=0
RETENTION_REQUEST_LOG_DAYS=30
RETENTION_SECURITY_EVENT_DAYS=180
